  @grist.formulaType(grist.Text())
  def Periode(rec, table):
    # Détermination de la date de début (priorité à $prolongation_DateCTOInitial)
    date_debut_obj = rec.prolongation_DateCTOInitial if rec.prolongation_DateCTOInitial else rec.Instance_ratache_date
    if not date_debut_obj:
        return "Erreur : Aucune date de début valide trouvée"

    # Détermination de la date de fin
    date_fin_obj = rec.Date_limite_financement
    if not date_fin_obj:
        return "Erreur : Aucune date de fin valide trouvée"

    # Formatage des dates
    try:
        date_debut = date_debut_obj.strftime("%d/%m/%Y")
        date_fin = date_fin_obj.strftime("%d/%m/%Y")
    except AttributeError:
        return "Erreur : Format de date invalide"

    # Retour du résultat
    return f"{date_debut} au {date_fin}"

