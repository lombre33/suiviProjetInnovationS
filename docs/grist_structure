  @grist.formulaType(grist.Text())
  def Demande_de_visa(rec, table):
    from urllib.parse import quote

    # Version optimisée pour Grist
    emails_clean = []
    for ref in rec.visa_destinataires:
        # Si c'est une référence à un Annuaire
        if hasattr(ref, 'Email'):
            emails_clean.append(ref.Email)
        # Si c'est une chaîne de caractères
        elif isinstance(ref, str):
            emails_clean.append(ref)

    # Créer le lien mailto
    return f"mailto:{';'.join(emails_clean)}?cc={rec.CC}&subject={quote(rec.Sujet)}&body={quote(rec.visas_corps)}"



