  def A(rec, table):
    if rec.ZRR is None:
        return False
    return rec.ZRR.lower() == "oui"

  @grist.formulaType(grist.Text())
  def Tutelle_principales(rec, table):
    if not rec.Tutelle_s_principale_s_:
        return ""

    # Remplacer "UBx" par "UB" et supprimer les espaces
    tutelle = rec.Tutelle_s_principale_s_.replace("UBx", "UB").replace(" ", "")

    # Garder uniquement l'acronyme avant le tiret "-"
    acronyme = tutelle.split("-")[0] if "-" in tutelle else tutelle

    return acronyme

  def Tutuelle_principale_2(rec, table):
    if "-" in rec.Tutelle_s_principale_s_:
        tutelle_part = rec.Tutelle_s_principale_s_.split("-")[1].strip()
    else:
        return ""

    # Étape 2 : Remplacer "UBx" par "UB" si présent
    tutelle_part = tutelle_part.replace("UBx", "UB")

    # Étape 3 : Retirer les espaces éventuels
    tutelle_part = tutelle_part.strip()

    return tutelle_part

  def Tutuelle_principale_2_2(rec, table):
    tutelle = rec.Tutelle_s_principale_s_

    # Étape 1 : Si pas de tiret ou un seul tiret, retourner une chaîne vide
    if "-" not in tutelle or tutelle.count("-") == 1:
        return ""

    # Étape 2 : Garder le texte à droite du deuxième tiret
    parts = tutelle.split("-")
    if len(parts) >= 3:
        tutelle = parts[2]
    else:
        return ""

    # Étape 3 : Remplacer "UBx" par "UB"
    tutelle = tutelle.replace("UBx", "UB")

    # Étape 4 : Retirer les espaces
    tutelle = tutelle.strip()

    return tutelle

  def prenom(rec, table):
    if not rec.Directeur:
        return ""

    # Diviser la chaîne en mots et prendre le dernier mot (prénom)
    prenoms = rec.Directeur.split()[-1]
    return prenoms.lower()



  def dir_acronyme(rec, table):
    return "Direction_Adjointe_"+rec.Acronyme

  def Nom_de_famille(rec, table):
    if not rec.Directeur:
        return ""
    # Séparer le nom et le prénom
    parts = rec.Directeur.split()
    if len(parts) > 0:
        # Le nom de famille est le premier élément (déjà en majuscules dans la colonne source)
        return parts[0]
    return ""

  def ville(rec, table):
    return None


