  def PDF(rec, table):
    import datetime
    import numbers

    # Classe utilisée pour la recherche des données
    class Find_Data(dict):
      def __missing__(self, key):
        attr = getattr(rec, key)
    
        # Formate la date en français
        if isinstance(attr, datetime.date):
          return attr.strftime(format = '%d/%m/%Y')
    
        # Arrondit les nombres à deux décimales 
        if isinstance(attr, numbers.Number):
          return '{:,.2f}'.format(attr).replace(",", " ")
          #return getattr(rec, key)
          #return '{:,.0f}'.format(attr).replace(",", " ")
        else:
          return getattr(rec, key)
    
  

    # 1. Récupère le modèle du document
    if rec.Type_projet =="Ingenierie_creation": 
    	template = Modele_Notification.lookupOne().HTML_creation
    elif rec.Type_projet =="Ingenierie_renouvellement": 
    	template = Modele_Notification.lookupOne().HTML_renouvellement
    elif rec.Type_projet =="reattribution" and rec.Signature == False: 
    	template = Modele_Notification.lookupOne().HTML_reattribution
    elif rec.Type_projet =="reattribution" and rec.Signature:
    	template = Modele_Notification.lookupOne().HTML_reattribution_signed
    elif rec.Type_projet =="prolongation": 
    	template = Modele_Notification.lookupOne().HTML_prolongation
    elif rec.Type_projet =="myphd+": 
    	template = Modele_Notification.lookupOne().HTML_myphd
    else:
    	template = Modele_Notification.lookupOne().HTML_projet

    # 2. Formate le modèle avec les champs de la table actuelle
    return template.format_map(Find_Data())


