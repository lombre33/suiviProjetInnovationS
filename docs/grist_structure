  @grist.formulaType(grist.Text())
  def nom_et_Prenom(rec, table):
    prenom = rec.Prenom
    nom = rec.NOM

    # Traitement du prénom
    if not prenom:
        prenom_trait = ""
    else:
        prenom_trait = prenom.capitalize()
        # Remplacement des tirets par un tiret suivi d'une majuscule
        prenom_trait = prenom_trait.replace('-', ' - ')

    # Traitement du nom
    if not nom:
        nom_trait = ""
    else:
        nom_trait = nom.upper()

    return f"{prenom_trait} {nom_trait}".strip()



