  @grist.formulaType(grist.Text())
  def Formule_email(rec, table):
    from urllib.parse import quote

    emails_clean = []
    for email in rec.Postes_Gestionaire_Administratif_secretariat_Annuaire_Email:
        if isinstance(email, list):
            for e in email:
                if isinstance(e, str):
                    clean_email = e.strip("[]'\" ")
                    if clean_email:  # Vérifie que l'email n'est pas vide après nettoyage
                        emails_clean.append(clean_email)
        elif isinstance(email, str):
            clean_email = email.strip("[]'\" ")
            if clean_email:
                emails_clean.append(clean_email)

    # Convertir en chaîne de caractères séparée par des virgules
    emails_str = ",".join(emails_clean)

    # Créer le lien mailto
    return f"mailto:{emails_str}&subject={quote(rec.Objet)}&body={quote(rec.Corps)}"

