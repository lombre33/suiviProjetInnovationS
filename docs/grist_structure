@grist.UserTable
class Envoie_Email_Notifications:
  Body = grist.Text()
  Projet = grist.Reference('Projets')
  B = grist.Reference('Notifications')

  @grist.formulaType(grist.Text())
  def Subject(rec, table):
    return "Notification projet "+rec.Projet.Acronyme

  @grist.formulaType(grist.ReferenceList('Annuaire'))
  def Projet_Porteur_s_(rec, table):
    return rec.Projet.Porteur_1

  def Email(rec, table):
    return rec.Projet_Porteur_s_.Email

  @grist.formulaType(grist.Text())
  def A(rec, table):
    from urllib.parse import quote

    emails_clean = []
    for email in rec.Email:
        if isinstance(email, list):
            for e in email:
                if isinstance(e, str):
                    clean_email = e.strip("[]'\" ")
                    if clean_email:  # Vérifie que l'email n'est pas vide après nettoyage
                        emails_clean.append(clean_email)
        elif isinstance(email, str):
            clean_email = email.strip("[]'\" ")
            if clean_email:
                emails_clean.append(clean_email)

    # Convertir en chaîne de caractères séparée par des virgules
    emails_str = ",".join(emails_clean)

    # Créer le lien mailto
    return f"mailto:{emails_str}?cc={rec.emailVP}&subject={quote(rec.Subject)}&body={quote(rec.Body)}"

  def Body3(rec, table):
    return rec.B.PDF

  def emailVP(rec, table):
    return rec.Projet.VP_porteur_signataire_notif.Email


