  @grist.formulaType(grist.Text())
  def Envoie_Email_Porteurs(rec, table):
    from urllib.parse import quote

    def clean_emails(email_list):
        emails_clean = []
        if isinstance(email_list, list):
            for item in email_list:
                emails_clean.extend(clean_emails(item))
        elif hasattr(email_list, 'Email'):
            email = email_list.Email
            if isinstance(email, str):
                emails_clean.append(email)
            elif isinstance(email, list):
                emails_clean.extend(clean_emails(email))
        elif isinstance(email_list, str):
            emails_clean.append(email_list)
        return emails_clean

    # Nettoyage des emails
    cc_clean = clean_emails(rec.CC)
    destinataire_clean = clean_emails(rec.Destinataire)

    # Vérification des résultats
    if not destinataire_clean:
        return "Erreur : Aucun destinataire valide"
    destinataire = destinataire_clean[0] if destinataire_clean else ""

    # Construction du lien mailto
    base_link = f"mailto:{destinataire}?subject={quote(rec.Mail_sujet)}&body={quote(rec.Corps)}"
    if cc_clean:
        base_link += f"&cc={','.join(cc_clean)}"
    return base_link

